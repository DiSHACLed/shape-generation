@prefix dash:       <http://datashapes.org/dash#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix shacl-play: <https://shacl-play.sparna.fr/ontology#> .
@prefix shape:      <https://shacl-play.sparna.fr/shapes/> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

shape:Person  rdf:type               sh:NodeShape ;
        rdfs:label                   "Person"@en ;
        sh:property                  shape:Person_birthday , shape:Person_birthDate , shape:Person_name ;
        sh:targetClass               <http://xmlns.com/foaf/0.1/Person> ;
        shacl-play:background-color  "blueviolet" .

shape:  rdf:type  <http://www.w3.org/2002/07/owl#Ontology> ;
        <http://purl.org/dc/terms/abstract>
                "Generated by SHACL Play!"@en ;
        <http://purl.org/dc/terms/created>
                "2026-04-23T10:01:41.518Z"^^xsd:dateTime .

shape:Person_birthday_datatype_2
        sh:datatype  xsd:string .

shape:Person_birthDate
        sh:datatype  xsd:date ;
        sh:maxCount  1 ;
        sh:name      "birthDate"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <https://schema.org/birthDate> .

shape:Person_birthday_datatype_1
        sh:datatype  xsd:dateTime .

shape:Person_birthday
        sh:maxCount  1 ;
        sh:name      "birthday"@en ;
        sh:nodeKind  sh:Literal ;
        sh:or        ( shape:Person_birthday_datatype_0 shape:Person_birthday_datatype_1 shape:Person_birthday_datatype_2 ) ;
        sh:path      <http://xmlns.com/foaf/0.1/birthday> .

shape:Person_birthday_datatype_0
        sh:datatype  xsd:date .

shape:Person_name  dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:string ;
        sh:in              ( "Eve Davis" "Alice Johnson" "Bob Smith" "Carol White" "David Brown" "Frank Miller" "Grace Wilson" "Henry Moore" "Iris Taylor" "Jack Anderson" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "name"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            <http://xmlns.com/foaf/0.1/name> .
