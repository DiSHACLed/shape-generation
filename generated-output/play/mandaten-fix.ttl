        sh:property     shape:Fractie_uuid , shape:Fractie_memberOf , shape:Fractie_linkedTo , shape:Fractie_legalName ;
        sh:targetClass  <http://data.vlaanderen.be/ns/mandaat#Fractie> .

shape:AgentInPositie_beleidsdomein_class_0
        sh:class  <http://mu.semte.ch/vocabularies/ext/BeleidsdomeinCode> .

shape:Person_sameAs  sh:class  <http://www.w3.org/ns/person#Person> ;
        sh:name      "sameAs"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      <http://www.w3.org/2002/07/owl#sameAs> .

shape:Bestuurseenheid_werkingsgebied_class_1
        sh:class  <http://www.w3.org/2004/02/skos/core#Concept> .

shape:Bestuursorgaan_classificatie_class_2
        sh:class  <http://www.w3.org/2004/02/skos/core#Concept> .

shape:Location_werkingsgebiedNiveau
        sh:datatype  xsd:string ;
        sh:in        ( "Gemeente" "Samengesteld werkingsgebied" "District" "Referentieregio" "Provincie" ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "werkingsgebiedNiveau"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://mu.semte.ch/vocabularies/ext/werkingsgebiedNiveau> .

shape:BestuurseenheidClassificatieCode_prefLabel_2
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:string ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "prefLabel"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            <http://www.w3.org/2004/02/skos/core#prefLabel> .

shape:Bestuurseenheid
        rdf:type        sh:NodeShape ;
        rdfs:label      "Bestuurseenheid"@en ;
        sh:property     shape:Bestuurseenheid_linkedTo , shape:Bestuurseenheid_classificatie , shape:Bestuurseenheid_prefLabel , shape:Bestuurseenheid_uuid , shape:Bestuurseenheid_werkingsgebied , shape:Bestuurseenheid_altLabel , shape:Bestuurseenheid_hasPrimarySite ;
        sh:targetClass  <http://data.vlaanderen.be/ns/besluit#Bestuurseenheid> .

shape:Mandataris_rangorde
        sh:datatype  xsd:string ;
        sh:name      "rangorde"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://data.vlaanderen.be/ns/mandaat#rangorde> .

shape:Membership  rdf:type  sh:NodeShape ;
        rdfs:label      "Membership"@en ;
        sh:property     shape:Membership_organisation , shape:Membership_uuid ;
        sh:targetClass  <http://www.w3.org/ns/org#Membership> .

shape:Mandataris_hasMembership_class_1
        sh:class  <http://www.w3.org/ns/activitystreams#Tombstone> .

shape:Bestuurseenheid_uuid
        sh:datatype  xsd:string ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "uuid"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://mu.semte.ch/vocabularies/core/uuid> .

shape:MandatarisStatusCode_prefLabel
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:string ;
        sh:in              ( "Titelvoerend" "Effectief" "Verhinderd" "Waarnemend" ) ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "prefLabel"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            <http://www.w3.org/2004/02/skos/core#prefLabel> .
