shape:BesluitVoorzitterBCSDNieuweStijl_description
        sh:datatype    rdf:langString ;
        sh:hasValue    "De voorzitter van het bijzonder comité voor de sociale dienst wordt voorgedragen door een akte van voordracht.De akte van voordracht van Open Vld-Lanaken en sp.a-Groen werd in ontvangst genomen door de Algemeen directeur op 12 november 2018.Kandidaat : Michel Stevens.Wordt de akte als ontvankelijk beschouwd, dan is de voorgedragen voorzitter automatisch verkozen.Door de eedaflegging in handen van de voorzitter van de OCMW-raad wordt de kandidaat ook lid van het vast bureau en meteen ook schepen.​"@nl ;
        sh:languageIn  ( "nl" ) ;
        sh:maxCount    1 ;
        sh:minCount    1 ;
        sh:name        "description"@en ;
        sh:nodeKind    sh:Literal ;
        sh:path        <http://data.europa.eu/eli/ontology#description> .

