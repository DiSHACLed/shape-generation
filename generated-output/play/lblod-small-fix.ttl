shape:b12630f-8c4e-40a4-8a61-a0c45621a1e6_description
        sh:datatype  xsd:string ;
        sh:in        ( " \n                                                            De gemeenteraad keurt de budgetten 2025 van de kerkfabrieken Sint Petrus & Paulus Herne, Sint-Niklaas Herfelingen, Sint Pieter te Sint-Pieters-Kapelle en OLV Kokejane goed, rekening houdende met de vereiste aanpassing via budgetwijziging door de kerkfabrieken in 2025. \n                                                        " " \n                                                            \n                                                                Voor de organisatie van Bornem Factor 24 werd door de gemeente voor het eerst met sponsorgelden gewerkt omdat de prijs voor heel wat zaken, o.a. artiesten, podia, materialen, gestegen is. De 3 Zonnekloppers worden jaarlijks georganiseerd in samenwerking met vzw Into The Night Events. Omdat ook zij met prijsstijgingen te maken hebben, gingen zij ook op zoek naar sponsoring. De meeste ondernemers tekenden echter in bij de gemeente. Het streefdoel was 8000 euro, er werd 9.500 euro aan sponsoring ontvangen. Aan de gemeenteraad wordt gevraagd om hiervan 1.500 euro toe te kennen aan vzw Into The Night Events.\n                                                             \n                                                             \n                                                                \n                                                                     \n                                                                 \n                                                             \n                                                            \n                                                                 \n                                                             \n                                                        " ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "description"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://data.europa.eu/eli/ontology#description> .

