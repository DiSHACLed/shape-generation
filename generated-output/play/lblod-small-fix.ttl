shape:BesluitSchepenenNieuweStijl_value
        sh:datatype    rdf:langString ;
        sh:hasValue    "\n  \n    Artikel 1\n    \n    De gemeenteraad neemt kennis van de ontvankelijke gezamenlijke akte van voordracht van de kandidaat-schepenen.\n  \n  \n    Artikel 2\n    \n    De gemeenteraad neemt kennis van het vastgelegd aantal schepenen, met name 5.\n  \n\n  \n    \n             1172cb60-9fb0-4609-8bda-47f21d3b9d9d\n               \n    Artikel 3\n    \n    De gemeenteraad verklaart volgende voorgedragen kandidaat-schepenen verkozen in de rangorde van de gezamenlijke akte van voordracht van de kandidaat-schepenen en neemt akte van hun eedaflegging:\n\n    \n      \n        \n          Rangorde\n          Officiële naam\n          Status\n          Begindatum mandaat\n          Einddatum mandaat\n        \n      \n      \n          \n            \n              \n                Eerste schepen\n              \n            \n            \n\n                    Astrid\n   Puts\n\n\n\n            \n            \n              \n                Effectief\n              \n            \n            \n              \n                2 januari 2019\n              \n            \n            \n              \n                31 december 2024\n              \n            \n          \n          \n            \n              \n                Tweede schepen\n              \n            \n            \n\n                    Christel\n   Gorissen\n\n\n\n            \n            \n              \n                Effectief\n              \n            \n            \n              \n                2 januari 2019\n              \n            \n            \n              \n                31 december 2024\n              \n            \n          \n          \n            \n              \n                Derde schepen\n              \n            \n            \n\n                    Sofie\n   Martens\n\n\n\n            \n            \n              \n                Effectief\n              \n            \n            \n              \n                2 januari 2019\n              \n            \n            \n              \n                31 december 2024\n              \n            \n          \n          \n            \n              \n                Vierde schepen\n              \n            \n            \n\n                    Peter\n   Verheyen\n\n\n\n            \n            \n              \n                Effectief\n              \n            \n            \n              \n                2 januari 2019\n              \n            \n            \n              \n                31 december 2024\n              \n            \n          \n          \n            \n              \n                Vijfde schepen\n              \n            \n            \n\n                    Jolein\n   Martens\n\n\n\n            \n            \n              \n                Effectief\n              \n            \n            \n              \n                2 januari 2019\n              \n            \n            \n              \n                31 december 2021\n              \n            \n          \n      \n    \n    \n  \n\n\n             58e67cd6-861a-494f-982c-e9bc794aa458\n            \n  \n"@nl ;
        sh:languageIn  ( "nl" ) ;
        sh:maxCount    1 ;
        sh:minCount    1 ;
        sh:name        "value"@en ;
        sh:nodeKind    sh:Literal ;
        sh:path        <http://www.w3.org/ns/prov#value> .

shape:d9c3d177-6dc6-4775-8c6a-1055a9cbdcc6_description
        sh:datatype  xsd:string ;
        sh:in        ( " \n                                                            Goedkeuren van het voorstel tot adviesvraag voor een statutenwijziging van Zorg Tielt \n                                                        " " \n                                                            In kader van de nakende einddatum (30 juni 2023) voor de fusies die noodzakelijk zijn voor de oprichting van de nieuwe woonmaatschappijen dient de werking van SVK Waasland te worden opgedeeld in drie regio's en overgedragen aan de betreffende woonmaatschappij. Daarna zal de welzijnsvereniging, na overdracht van personeel en patrimonium, worden ontbonden. \n                                                            Het merendeel van het personeel zal worden overgenomen door de regio Waasland Midden. De statutairen zullen worden overgedragen aan OCMW/Stad Sint-Niklaas. Tuinwijk Lokeren zal vanaf 1 april 2023 de SVK-werking overnemen en een overdracht afronden van het patrimonium en boekhouding. Waasland Oost zal de SVK-werking overnemen op 12 juni 2023. Voor Waasland Midden zal de fusie tegen eind juni 2023 ingepland worden. \n                                                            Het SVK zal vanaf dan als lege organisatie bestaan en zal na uitstap van de deelgenoten moeten worden ontbonden. Om die reden wordt gevraagd aan de deelgenoten om op hun bestuursorgaan (Raad voor maatschappelijk welzijn/gemeenteraad) de uitstap uit de vereniging reeds laten agenderen zodat een Algemene Vergadering van 6 april 2023 kan beslissen tot de uitstap en de ontbinding. \n                                                        " " \n                                                    De raad voor maatschappelijk welzijn neemt kennis van de voorliggende, aangepaste statuten van Aan-Z goed en heeft hierbij geen opmerkingen. \n                                                " " \n                                                    De raad voor maatschappelijk welzijn neemt kennis van de voorliggende, aangepaste statuten van Aan-Z goed en heeft hierbij geen opmerkingen.  \n                                                " " \n                                                                    Sedert 1 januari 2019 (fusie) is de zetel van het OCMW gevestigd in de Palingstraat 48, 2870 Puurs-Sint-Amands.  \n                                                                    Vanaf begin april 2024 verhuizen de medewerkers van de meeste gemeente- en OCMW-diensten naar het nieuw gemeentehuis.  \n                                                                    Het nieuwe gemeentehuis is toegankelijk voor de inwoners vanaf 22 april 2024.  \n                                                                    Zodoende dient de zetel van het OCMW vanaf dan gewijzigd te worden van Palingstraat 48, 2870 Puurs-Sint-Amands naar Forum 6, 2870 Puurs-Sint-Amands. \n                                                                " ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "description"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://data.europa.eu/eli/ontology#description> .

