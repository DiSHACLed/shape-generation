shape:f8c070bd-96e4-43a1-8c6e-532bcd771251_description
        sh:datatype  xsd:string ;
        sh:in        ( " \n                                                            Overeenkomstig de regelgeving rond vzw's, wordt aan de gemeenteraad gevraagd de agenda van de algemene vergadering van 28/05/2025 goed te keuren. \n                                                        " " \n                                                            Overeenkomstig de regelgeving rond vzw's, wordt aan de gemeenteraad gevraagd de agenda van de algemene vergadering van 03/06/2025 goed te keuren. \n                                                        " " \n                                                            Overeenkomstig de regelgeving rond vzw's, wordt aan de gemeenteraad gevraagd de agenda van de algemene vergadering van 02/06/2025 goed te keuren. \n                                                        " " \n                                                            EVA-vzw GC de oude pastorie organiseert in opdracht van het gemeentebestuur activiteiten met het oog op cultuurparticipatie, gemeenschapsvorming en cultuurspreiding. De vzw wordt belast met de verwezenlijking van welbepaalde beleidsuitvoerende en beleidsvoorbereidende taken van gemeentelijk belang, met name de opmaak en uitvoering van de programmering van gemeenschapscentrum de oude pastorie en de maatregelen die hiervoor nodig zijn.  \n                                                            De statuten bepalen de werking van de EVA-vzw. De samenwerkingsovereenkomst en de afsprakennota regelen de verhoudingen tussen de gemeente en de EVA-vzw, de afstemming van het beleid tussen de gemeente en de vereniging, de nadere omschrijving en afbakening van de opdrachten en verantwoordelijkheden van de vereniging ten opzichte van de gemeente en de engagementen van de gemeente ten opzichte van de vereniging.  \n                                                            Bij de start van een nieuwe legislatuur dient de gemeenteraad de bestaande statuten, het organiek reglement en de afsprakennota m.b.t. EVA-vzw de oude pastorie te bekrachtigen. \n                                                        " ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "description"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://data.europa.eu/eli/ontology#description> .

