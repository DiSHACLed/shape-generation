shape:d85218e2-a75f-4a30-9182-512b5c9dd1b2_description
        sh:datatype  xsd:string ;
        sh:in        ( " \n                                                            De gemeenteraad gaat akkoord met de voorgestelde wijziging van de verdeelsleutel op basis van de 3-staps aanpak. \n                                                        " " \n                                                            De gemeenteraad neemt akte van het budget 2026 van het kerkbestuur St.-Martinus. \n                                                        " " \n                                                            De gemeenteraad neemt akte van het budget 2026 van het kerkbestuur St.-Niklaas. \n                                                        " " \n                                                            De gemeenteraad neemt akte van het budget 2026 van het kerkbestuur St.-Catharina. \n                                                        " " \n                                                            De gemeenteraad neemt akte van het budget 2026 van het kerkbestuur St.-Rumoldus. \n                                                        " " \n                                                            De gemeenteraad neemt akte van het budget 2026 van de kerkfabrieken Sint-Jan-Baptist, Onze-Lieve-Vrouw, Sint-Bavo en Sint-Eligius. \n                                                        " " \n                                                    Een gewone dotatie wordt aan de politiezone ‘ZARA’ toegekend ten belope van 2.023.747 euro, uitgetrokken onder GBB/0400-00/649330 van de exploitatieuitgaven van het budget 2025. \n                                                " " \n                                                    Een gewone dotatie wordt aan de politiezone ‘ZARA’ toegekend ten belope van 2.023.747 euro, uitgetrokken onder ACT-4.2.1/0400-00/649330 van de exploitatie uitgaven van het budget 2026. \n                                                " ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "description"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://data.europa.eu/eli/ontology#description> .

