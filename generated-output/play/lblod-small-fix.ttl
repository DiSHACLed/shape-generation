shape:ae4d36-de0c-425d-9dbe-3b6deef8343c_description
        sh:datatype  xsd:string ;
        sh:in        ( " \n                                                    De raad voor maatschappelijk welzijn neemt kennis van aanpassing 5 van het meerjarenplan 2020-2025 van welzijnsvereniging Zorgbedrijf Meetjesland. \n                                                " " \n                                                    De aanpassing van het meerjarenplan nr. 3 - 2020-2025 van het OCMW Zandhoven, dat heden werd vastgesteld door de OCMW-raad, wordt goedgekeurd.De goedkeuring vermeld in artikel 1, impliceert dat de gemeenteraad de aanpassing van het meerjarenplan nr. 3 - 2020-2025 voor beide entiteiten vaststelt. \n                                                " ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "description"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://data.europa.eu/eli/ontology#description> .

