shape:c6b696c0-26f8-4e87-b7e8-071b81471ddc_description
        sh:datatype  xsd:string ;
        sh:in        ( " \n                                                    De gemeenteraad keurt de verlenging van de projectvereniging Cultuurregio Leie Schelde met 1 jaar, tot 2026, goed. \n                                                " " \n                                                            De gemeenteraad gaat akkoord met de verlenging van de projectvereniging voor zes jaar. \n                                                        " " \n                                                                    De verlenging met de intergemeentelijke projectvereniging wijk-werken Vlaamse Ardennen wordt goedgekeurd voor de volgende beleidsperiode 2024 tot 2029 zodat de continuïteit van de dienstverlening kan gegarandeerd worden. \n                                                                " " \n                                                            Door de toekomstige decreetswijziging wordt de huidige beleidsperiode van de IGS’en bovenlokale cultuur door de Vlaamse overheid verlengd met 1 jaar. Normaal startte de nieuwe beleidsperiode op 1 januari 2026. Dat wordt nu 1 januari 2027. Deze aanpassing aan het decreet komt er omdat ze de indiendata en beleidsperiodes van intergemeentelijke samenwerkingsverbanden rond cultuur willen laten samenlopen met IOED’s (onroerend erfgoed) en culturele erfgoedcellen. \n                                                            De IGS Viertoren heeft de vorm van een projectvereniging (PV). Dat heeft een looptijd van max. 6 jaar. De projectvereniging loopt af in 2025. Door de verlenging van de huidige beleidsperiode moeten bepaalde IGS’en de looptijd van hun projectvereniging ook verlengen, zo is de IGS Viertoren juridisch in orde. Dat is noodzakelijk om subsidies te ontvangen van de Vlaamse overheid voor een extra jaar. \n                                                            De statuten van Viertoren moeten ook worden aangepast. In de vorige statuten stond onder Artikel 4: Duur van de projectvereniging: De projectverenging wordt opgericht voor de periode van 1 oktober 2019 tot 30 september 2025. Dat wordt in de nieuwe statuten: De projectvereniging wordt opgericht voor de periode van 1 oktober 2019 tot 31 december 2026. \n                                                        " " \n                                                                    De gemeenteraad beslist tot de verlenging van de duur van de projectvereniging VARIANT tot en met 31.12.2026 en beslist de bijhorende gemeentelijke bijdrage goed te keuren. \n                                                                " ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "description"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://data.europa.eu/eli/ontology#description> .

