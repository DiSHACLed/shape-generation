shape:b25faa84-3ab5-47ae-98c0-1b389c77b827_value
        sh:datatype  xsd:string ;
        sh:hasValue  " \n                                                                 \n                                                                    besluit \n                                                                    Artikel 1 \n                                                                    De gemeenteraad beslist om tegen het ministerieel besluit houdende de erkenning van de lokale geloofsgemeenschap \"Christengemeente Londerzeel\" te Londerzeel een beroep tot nietigverklaring in te dienen bij de afdeling bestuursrechtspraak van de Raad Van State; \n                                                                    Artikel 2   \n                                                                    De gemeenteraad mandateert het college van burgemeester en schepenen met de praktische afwikkeling. \n                                                                     \n                                                                 \n                                                            " ;
