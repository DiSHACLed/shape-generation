shape:ec2-e8a1-411f-bb96-d0ea517d7051_value
        sh:datatype  xsd:string ;
        sh:in        ( " \n                                 \n                                    Besluit \n                                    Artikel 1. De volgende dienst, zoals voorzien als bijlagen van de statuten van INTERLEUVEN, wordt in exclusiviteit toegekend aan de zelfstandige groepering ‘Interleuven ondersteunende activiteiten’ (BTW BE 0205.774.810), Brouwersstraat 6 - 3000 Leuven, met ingang van 15 september 2021 tot en met 31 december 2025, met dien verstande dat opdrachten die werden toegekend vóór het verstrijken van voormelde periode, zullen worden afgewerkt onder het systeem van de exclusieve dienstverlening - 15.1, het begeleiden, ondersteunen en adviseren bij vastgoedaspecten.Artikel 2. De samenwerkingsovereenkomst exclusieve dienstverlening tussen de zelfstandige groepering 'Interleuven ondersteunende activiteiten' en de gemeente in bijlage dewelke integraal deel uitmaakt van dit besluit wordt goedgekeurd.  \n                                      \n                                      \n                                 \n                            " " \n                                                                 \n                                                                    \n                                                                        BESLUIT:\n                                                                     \n                                                                    Enig artikel: De gemeenteraad bevestigt dat de heer Robby Van der Stock het mandaat voor de fractie N-VA, vrijgekomen door het ontslag van de heer François Van den Broeck als gemeenteraadslid, in de EVA vzw Dienst 112 Hamme opneemt. \n                                                                 \n                                                            " " \n                                                         \n                                                            \n                                                                BESLUIT:\n                                                             \n                                                            Enig artikel: De gemeenteraad bevestigt dat de heer Frank Van Erum het mandaat voor de fractie Open VLD, vrijgekomen door het ontslag van de heer Tom Waterschoot als gemeenteraadslid, in de EVA vzw Dienst 112 Hamme opneemt. \n                                                         \n                                                    " " \n                                                         \n                                                            \n                                                                BESLUIT:\n                                                             \n                                                            Enig artikel: De gemeenteraad bevestigt dat mevrouw Fatima Gökce het mandaat in de EVA vzw Dienst 112 zal opnemen in de plaats van de heer Jan Rosschaert voor de fractie Vooruit. \n                                                         \n                                                    " " \n                                                                 \n                                                                    \n                                                                        BESLUIT:\n                                                                     \n                                                                    Enig artikel: De gemeenteraad bevestigt dat de heer Mathieu Weyn het mandaat voor de fractie Open VLD, vrijgekomen door het ontslag van de heer Henri Peelman als gemeenteraadslid, in de EVA vzw Dienst 112 Hamme opneemt. \n                                                                 \n                                                            " ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "value"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://www.w3.org/ns/prov#value> .

