shape:ec2-e8a1-411f-bb96-d0ea517d7051_description
        sh:datatype  xsd:string ;
        sh:in        ( " \n                                                            De volgende dienst, zoals voorzien als bijlagen van de statuten van INTERLEUVEN, wordt in exclusiviteit toegekend aan de zelfstandige groepering ‘Interleuven ondersteunende activiteiten’ (BTW BE 0205.774.810), Brouwersstraat 6 - 3000 Leuven, met ingang van 15 september 2021 tot en met 31 december 2025, met dien verstande dat opdrachten die werden toegekend vóór het verstrijken van voormelde periode, zullen worden afgewerkt onder het systeem van de exclusieve dienstverlening - 15.1, het begeleiden, ondersteunen en adviseren bij vastgoedaspecten. \n                                                            De samenwerkingsovereenkomst exclusieve dienstverlening tussen de zelfstandige groepering 'Interleuven ondersteunende activiteiten' en de gemeente in bijlage dewelke integraal deel uitmaakt van dit besluit wordt goedgekeurd.  \n                                                        " " \n                                                            Gezien de heer François Van den Broeck lid was van de raad van bestuur/algemene vergadering van de EVA vzw Dienst 112 Hamme, maar ontslag nam als gemeenteraadslid (waarvan de gemeenteraad akte nam in zitting van heden), zal hij dienen worden te vervangen. \n                                                            De voorgedragen kandidaat voor de fractie N-VA betreft raadslid Robby Van der Stock. \n                                                        " " \n                                                    Gezien de heer Tom Waterschoot lid was van de raad van bestuur/algemene vergadering van de EVA vzw Dienst 112 Hamme, maar ontslag nam als gemeenteraadslid (waarvan de gemeenteraad akte nam in zitting van 15 december 2021), zal hij dienen worden te vervangen. \n                                                    De voorgedragen kandidaat voor de fractie Open VLD betreft raadslid Frank Van Erum. \n                                                " " \n                                                    Voor fractie Vooruit zal de heer Jan Rosschaert het mandaat van vertegenwoordiger (algemene vergadering/bestuursorgaan) overdragen aan mevrouw Fatima Gökce, die in gemeenteraadszitting van heden geïnstalleerd werd als gemeenteraadslid. \n                                                " " \n                                                            Gezien de heer Henri Peelman lid was van het bestuursorgaan/algemene vergadering van de EVA vzw Dienst 112 Hamme, maar ontslag nam als gemeenteraadslid (waarvan de gemeenteraad akte nam in zitting van heden), zal hij dienen worden te vervangen. \n                                                            De voorgedragen kandidaat voor de fractie Open VLD betreft de heer Mathieu Weyn, die geïnstalleerd werd als gemeenteraadslid in zitting van heden. \n                                                        " ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "description"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://data.europa.eu/eli/ontology#description> .

