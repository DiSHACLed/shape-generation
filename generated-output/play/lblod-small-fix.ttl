        sh:datatype    rdf:langString ;
        sh:hasValue    "Er werd een gezamenlijke akte van voordracht van de kandidaat-schepenen voorgelegd door de Open Vld-Lanaken en sp.a-Groen.Voorstel : - eerste schepen : Astrid Puts- tweede schepen : Christel Gorissen- derde schepen : Sofie Martens- vierde schepen : Peter Verheyen- vijfde schepen : Jolein Martens met einddatum 31 december 2021   opvolger vijfde schepen : Dominique Terwingen.Deze akte van voordracht werd ontvangen door de Algemeen directeur op 12 november 2018.​"@nl ;
        sh:languageIn  ( "nl" ) ;
        sh:maxCount    1 ;
        sh:minCount    1 ;
        sh:name        "description"@en ;
        sh:nodeKind    sh:Literal ;
        sh:path        <http://data.europa.eu/eli/ontology#description> .

