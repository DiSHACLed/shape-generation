shape:e23d-617d-48b9-9c00-3d679ae88fec_description
        sh:datatype  xsd:string ;
        sh:in        ( " \n                                                                    De aangepaste beheersovereenkomst 2019-2024 waarin de wederzijdse verplichtingen van de stad Deinze en het autonoom gemeentebedrijf AGB Stad Deinze geregeld worden, wordt goedgekeurd met ingang van 1 januari 2024. \n                                                                " " \n                                                                    De aangepaste beheersovereenkomst 2019-2024 waarin de wederzijdse verplichtingen van de stad Deinze en het autonoom gemeentebedrijf AGB Stad Deinze geregeld worden, wordt goedgekeurd met ingang van 1 januari 2022. \n                                                                " " \n                                                                            Conform artikel 233 van het decreet over het lokaal bestuur stelt de raad van bestuur voor om over te gaan tot aanpassing van de statuten van het AGB Stad Deinze en verleent deze tevens het benodigde advies. Meer bepaald wordt voorgesteld om artikel 32 van de statuten te wijzigen zodanig dat het directiecomité een personeelslid van het autonoom gemeentebedrijf AGB Stad Deinze en/of van de stad Deinze kan aanduiden die bevoegd is voor het vaststellen van concrete prijzen en het assortiment in het kader van de concessie van het Leietheater. Op deze manier wordt het praktisch een stuk werkbaarder en wordt de bewegingsvrijheid van de concessionaris vergroot. \n                                                                        " " \n                                                                    De aangepaste beheersovereenkomst 2019-2024 waarin de wederzijdse verplichtingen van de stad Deinze en het autonoom gemeentebedrijf AGB Stad Deinze geregeld worden, wordt goedgekeurd met ingang van 1 januari 2024. De aanpassing betreft de verhoging van de delegatiedrempel voor de ambtelijke gunning van 2.500 euro eBTW naar 10.000 eBTW én de oprichting van een Intern Meldpunt. \n                                                                " " \n                                                                    Conform artikel 233 van het decreet over het lokaal bestuur stelt de raad van bestuur voor om over te gaan tot aanpassing van de statuten van het AGB Stad Deinze en verleent deze tevens het benodigde advies. Meer bepaald wordt voorgesteld om artikel 32 van de statuten te wijzigen zodanig dat het directiecomité een personeelslid van het autonoom gemeentebedrijf AGB Stad Deinze en/of van de stad Deinze kan aanduiden die bevoegd is voor het vaststellen van concrete prijzen en het assortiment in het kader van de concessie van het Leietheater. Op deze manier wordt het praktisch een stuk werkbaarder en wordt de bewegingsvrijheid van de concessionaris vergroot \n                                                                " " \n                                                                    De aangepaste beheersovereenkomst 2019-2024 waarin de wederzijdse verplichtingen van de stad Deinze en het autonoom gemeentebedrijf AGB Stad Deinze geregeld worden, wordt goedgekeurd met ingang van 1 januari 2023. \n                                                                " " \n                                                                    De aangepaste beheersovereenkomst 2019-2024 waarin de wederzijdse verplichtingen van de stad Deinze en het autonoom gemeentebedrijf AGB Stad Deinze geregeld worden, wordt goedgekeurd met ingang van 1 januari 2024. De aanpassing betreft de verhoging van de delegatiedrempel voor de ambtelijke gunning van 2.500 euro eBTW naar 10.000 eBTW én de oprichting van een Intern Meldpunt. \n                                                                " " \n                                                                    De raad van bestuur verleent positief met betrekking tot de gewijzigde gecoördineerde statuten. \n                                                                " " \n                                                                    Het college van burgemeester en schepenen en het directiecomité gingen in zitting van 15 september 2020 akkoord om de kredieten voor de jeugdkampen en speelpleinwerking over te hevelen van stad naar AGB met uitzondering van de uitgaven voor de uitbetaling van de monitoren (jobstudenten en vrijwilligers). \n                                                                    Artikel 6 - Tariefbepaling van de huidige beheersovereenkomst 2019-2024 die de wederzijdse verplichtingen tussen de stad Deinze en het autonoom gemeentebedrijf AGB Stad Deinze regelt, dient daarom aangepast te worden voor wat betreft de maximumtarieven die gehanteerd worden voor jeugdactiviteiten. \n                                                                " " \n                                                    Goedkeuring wordt gegeven om de statuten van het autonoom gemeentebedrijf Ardooie te wijzigen. \n                                                " " \n                                                                    In artikel 4 van de huidige statuten van het AGB Puurs-Sint-Amands staat als maatschappelijke zetel vermeld: Hoogstraat 29 te 2870 Puurs-Sint-Amands. \n                                                                    Gelet op de verhuis naar het nieuwe gemeentehuis, wordt voorgesteld om de maatschappelijke zetel van het AGB Puurs-Sint-Amands met ingang van 22 april 2024 te verplaatsen naar het adres Forum 6, 2870 Puurs-Sint-Amands. \n                                                                    De wijzigingen in de statuten worden aangebracht bij beslissing van de gemeenteraad, op voorstel of na advies van de raad van bestuur van het autonoom gemeentebedrijf in kwestie. \n                                                                " " \n                                                                    In artikel 4 van de huidige statuten staat als maatschappelijke zetel van het AGB Puurs-Sint-Amands vermeld Hoogstraat 29 te 2870 Puurs-Sint-Amands. \n                                                                    Gelet op de verhuis naar het nieuwe gemeentehuis wordt voorgesteld om de maatschappelijke zetel van het AGB Puurs-Sint-Amands met ingang van 22 april 2024 te verplaatsen naar het adres Forum 6, 2870 Puurs-Sint-Amands. \n                                                                    De wijzigingen in de statuten worden aangebracht bij beslissing van de gemeenteraad, op voorstel of na advies van de raad van bestuur van het autonoom gemeentebedrijf in kwestie. \n                                                                " ) ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "description"@en ;
        sh:nodeKind  sh:Literal ;
        sh:path      <http://data.europa.eu/eli/ontology#description> .

