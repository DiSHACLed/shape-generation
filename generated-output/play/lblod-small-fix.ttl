shape:BesluitVerkiezingVoorzitter_value
        sh:datatype    rdf:langString ;
        sh:in          ( "\n  \n    \n      Artikel 1\n      \n      Akte te nemen van de tijdige en ontvankelijke akte van voordracht van kandidaat-voorzitter.\n    \n  Artikel 2\n  \n  \n    De voorgedragen kandidaat-voorzitter, \n            Ann Van de Casteele\n            ​, wordt verkozen verklaard als \n           \n          \n            voorzitter van de gemeenteraad\n          \n         met ingang van 7 januari 2019, 20:19.​\n  \n"@nl "\n  \n    \n      Artikel 1\n      \n      Akte te nemen van de tijdige en ontvankelijke akte van voordracht van kandidaat-voorzitter.\n    \n    \n  Artikel 2\n  \n  \n    De voorgedragen kandidaat-voorzitter,  Sandy Evrard\n         , wordt verkozen verklaard als \n           \n          \n            voorzitter van de gemeenteraad\n          \n         met ingang van 2 januari 2019, 19:15.\n    \n  \n​​\n"@nl "\n    \n      \n        Artikel 1\n        \n        Kennis te nemen van de tijdige en ontvankelijke akte van voordracht van kandidaat-voorzitter.\n  Artikel 2\n  \n  \n    De voorgedragen kandidaat-voorzitter, \n            Johan Vanhulst\n             , wordt verkozen verklaard als \n           \n          \n            voorzitter van de gemeenteraad\n          \n         met ingang van 2 januari 2019.\n    \n  \n​\n      \n    \n  "@nl ) ;
        sh:languageIn  ( "nl" ) ;
        sh:maxCount    1 ;
        sh:minCount    1 ;
        sh:name        "value"@en ;
        sh:nodeKind    sh:Literal ;
        sh:path        <http://www.w3.org/ns/prov#value> .

