        rdf:type        sh:NodeShape ;
        rdfs:label      "e27ef237-29de-49b8-be22-4ee2ab2d4e5b"@en ;
        sh:property     shape:e27ef237-29de-49b8-be22-4ee2ab2d4e5b_wasDerivedFrom , shape:e27ef237-29de-49b8-be22-4ee2ab2d4e5b_uuid , shape:e27ef237-29de-49b8-be22-4ee2ab2d4e5b_passed_by , shape:e27ef237-29de-49b8-be22-4ee2ab2d4e5b_description , shape:e27ef237-29de-49b8-be22-4ee2ab2d4e5b_motivering , shape:e27ef237-29de-49b8-be22-4ee2ab2d4e5b_extractedDecisionContent , shape:e27ef237-29de-49b8-be22-4ee2ab2d4e5b_language , shape:e27ef237-29de-49b8-be22-4ee2ab2d4e5b_wasGeneratedBy , shape:e27ef237-29de-49b8-be22-4ee2ab2d4e5b_value , shape:e27ef237-29de-49b8-be22-4ee2ab2d4e5b_title ;
