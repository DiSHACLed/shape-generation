<http://shaclshapes.org/description00527d30-e60b-4fa5-9152-f42dddd10ff6ShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
  <http://example.org/example> """ 
                                                                    De gemeenteraad beslist tot goedkeuring en ambtshalve aanpassing van de wijziging aan het meerjarenplan 2020-2025 en beslist tot kennisname en ambtshalve aanpassing van het budget 2023 en tot kennisname van de budgetwijziging 2022 van de kerkfabriek Alle Heiligen. 
                                                                """ ;
  <http://example.org/example> """ 
                                                                    Er wordt goedkeuring verleend aan het gewijzigd meerjarenplan 2020-2025 (2022) van de kerkfabriek Sint-Martinus en Sint-Christoffel. 
                                                                """ ;
  <http://example.org/example> """ 
                                                            De gemeenteraad neemt keurt de aangevraagde toelage van 2023 van de kerkfabriek Sint-Pieter Sint-Pieters-Kapelle goed en de overschrijding van de gevraagde toelagen van Sint-Pieter Sint-Pieters-Kapelle, Sint Petrus & Paulus Herne, Sint-Niklaas Herfelingen en OLV Kokejane, goed. 
                                                        """ ;
  <http://example.org/example> """ 
                                                    Bij de goedkeuring van het budget in 2021 werd voor 2022 al een investeringstoelage voorzien van 20 000 euro, die blijft behouden in deze budgetwijziging. 
                                                    Met deze budgetwijziging wordt 1 500 euro investeringstoelage voor energieaudit toegevoegd. 
                                                """ ;
  <http://example.org/example> """ 
                                                    De gemeenteraad geeft de goedkeuring aan het gewijzigd meerjarenplan 2020-2025 voor kerkfabriek Heilige Margaretha van Sint-Margriete. 
                                                """ ;
  <http://shaclshapes.org/confidence> 6.7677E-1 ;
