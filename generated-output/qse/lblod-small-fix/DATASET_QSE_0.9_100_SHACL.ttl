                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        Goedgekeurd, met eenparigheid van stemmen                                                               06. Toetreding tot de raamovereenkomst van het Facilitair Bedrijf Digitaal Vlaanderen inzake authentiseren en handtekenen door personeel en burgers De raad voor maatschappelijk welzijn keurde de toetreding tot de raamovereenkomst inzake authentiseren en handtekenen door personeel en burgers van het Facilitair Bedrijf Digitaal Vlaanderen goed.Raad voor maatschappelijk welzijn, Gelet op het decreet over het lokaal bestuur, inzonderheid artikel 78, 10° houdende de bevoegdheden van de gemeenteraad inzake overheidsopdrachten;Gelet op de wet inzake overheidsopdrachtenGelet op de wet betreffende de motivering, de informatie en de rechtsmiddelen inzake overheidsopdrachten en bepaalde opdrachten voor werken, leveringen en diensten en latere wijzigingen;Gelet op het koninklijk besluit plaatsing overheidsopdrachten in de klassieke sectorenGelet op het KB van 14 januari 2013 betreffende de algemene uitvoeringsregels en algemene aannemingsvoorwaarden en latere wijzigingen;Overwegende dat het Facilitair Bedrijf Digitaal Vlaanderen optreedt als aankoopcentrale in de zin van artikel 2, 6° van de wet overheidsopdrachten van 17 juni 2016 voor de klanten die tot de rechtspersoon Vlaamse Gemeenschap en Vlaamse Gewest behoren, waaronder de lokale overheden (zie basisbestek, hoofdstuk 5.1 punt 12.1);Gelet op het besluit van de Vlaamse regering tot delegatie van de beslissingsbevoegdheden aan de leden van de Vlaamse Regering;Gelet op het inroepen binnen het raamcontract van de procedure zonder voorafgaande bekendmaking (artikel 42, § 1, 1° d) van de wet op overheidsopdrachten van 17 juni 2016 en de derhalve gunning aan Vanden Broele met adres te Lieven Bauwensstraat 35, 8200 Brugge;Overwegende dat zowel de gemeente als het welzijnshuis van de mogelijkheid tot afname van de raamovereenkomst kan gebruik maken waardoor zij krachtens artikel 47, § 2 van de wet van 17 juni 2017 vrijgesteld is van de verplichting om zelf een gunningsprocedure te organiseren;Overwegende dat deze toetreding een vereiste is om bij een eventuele latere bestelling bij Vanden Broele (huidige leverancier van een elektronisch ondertekenplatform eSignFlow) de itsme-integratie te realiseren;Gelet op het feit dat, gebaseerd op de initiële looptijd (1 jaar) van het contract, de einddatum 31 december 2025 is met driemalige optie op verlenging van telkens 1 jaar;Overwegende dat noch gemeente, noch welzijnshuis verplicht zijn tot enige afname van de raamovereenkomst;Gelet op de reeds goedgekeurde toetreding tot deze overeenkomst voor de gemeente, op de gemeenteraad van 28 april 2025;Overwegende dat er een technische noodzaak is tot toetreding voor beide entiteiten (gemeente en welzijnshuis) ten einde de nodige rechten te kunnen toekennen aan alle medewerkers die in het systeem zitten;Beslist,Artikel 1. De raad voor maatschappelijk welzijn keurt de toetreding tot de raamovereenkomst inzake authentiseren en handtekenen door personeel en burgers van het Facilitair Bedrijf Digitaal Vlaanderen goed.Art. 2. Het vast bureau wordt gelast met de uitvoering van dit besluit.Art. 3. Dit besluit gaat in vanaf 2 september 2025 en geldt tot de uiterste datum van deze raamovereenkomst zijnde 31 december 2025, behoudens eventuele verlengingen. Over een eventuele verlenging zal beslist worden conform de op dat moment geldende definitie van ‘dagelijks bestuur’.            
            
