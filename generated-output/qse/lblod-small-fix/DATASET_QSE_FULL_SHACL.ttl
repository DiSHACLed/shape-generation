  <http://example.org/example> """ 
                                                                    De raad voor maatschappelijk welzijn keurt het meerjarenplan 2023-2025 voor het lokaal dienstencentrum Ter Borre goed. 
                                                                """ ;
  <http://shaclshapes.org/confidence> 1E0 ;
