<http://shaclshapes.org/valueb25faa84-3ab5-47ae-98c0-1b389c77b827ShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
  <http://example.org/example> """ 
                                                                 
                                                                    besluit 
                                                                    Artikel 1 
                                                                    De gemeenteraad beslist om tegen het ministerieel besluit houdende de erkenning van de lokale geloofsgemeenschap "Christengemeente Londerzeel" te Londerzeel een beroep tot nietigverklaring in te dienen bij de afdeling bestuursrechtspraak van de Raad Van State; 
                                                                    Artikel 2   
                                                                    De gemeenteraad mandateert het college van burgemeester en schepenen met de praktische afwikkeling. 
                                                                     
                                                                 
                                                            """ ;
  <http://shaclshapes.org/confidence> 1E0 ;
  <http://shaclshapes.org/support> "1"^^xsd:int ;
  <http://www.w3.org/ns/shacl#NodeKind> <http://www.w3.org/ns/shacl#Literal> ;
