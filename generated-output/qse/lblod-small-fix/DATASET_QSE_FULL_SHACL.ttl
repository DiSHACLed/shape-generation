                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            Goedgekeurd, met eenparigheid van stemmen                                                                https://data.vlaanderen.be/id/concept/BesluitType/e96ec8af-6480-4b32-876a-fefe5f0a3793Openbare titel besluit:Goedkeuring van het PV van de zitting van 23 mei 2022​​Het PV van de vergadering van 23 mei 2022 wordt goedgekeurd. Het PV van de vergadering van 23 mei 2022 wordt goedgekeurd.​                                                  Openbare behandeling van agendapunt                                Kennisneming verslag organisatiebeheersing              (gepland)                      Aanwezigen bij agendapunt                                                                              Aanwezige leden                                                                                                                                Christophe                               Boulert                                                           (Gemeenteraadslid)                                                                                                              Benjamin                              Daro                                                           (Gemeenteraadslid)                                                                                                              Benjamin                              Desmet                                                           (Gemeenteraadslid)                                                                                                              Arlette                              Goossens                                                           (Gemeenteraadslid)                                                                                                              Joëlle                              Grimmeau                                                           (Gemeenteraadslid)                                                                                                              Gilles                              Hallez                                                           (Gemeenteraadslid)                                                                                                              Charlotte                              Hollander                                                           (Gemeenteraadslid)                                                                                                              Roel                               Leemans                                                           (Gemeenteraadslid)                                                                                                              Cédric                              Letier                                                           (Gemeenteraadslid)                                                                                                              Paul                              Opoczynski                                                           (Gemeenteraadslid)                                                                                                              Damien                              Thiéry                                                           (Gemeenteraadslid)                                                                                                              Pierri                              Vercheval                                                           (Gemeenteraadslid)                                                                                                                                      Afwezige leden                                                                                                                                Yves                              Ghequiere                                                           (Gemeenteraadslid)                                                                                                              Charlotte                              Houset                                                           (Gemeenteraadslid)                                                                                                              Mariette                              Wennmacher                                                           (Gemeenteraadslid)                                                                                                      Voorzitter:                                                                Roel                         Leemans                                                                                            Secretaris:                                                            Veerle                      De Brael                                                                                        Openbare titel besluit:Kennisneming verslag organisatiebeheersingKorte openbare beschrijving:De gemeenteraad neemt kennis van het jaarrapport 2022 dat werd opgesteld in samenwerking met het aangesteld bureau betreffende het organisatiebeheersingssysteem van de gemeente en het OCMW van Linkebeek. De gemeenteraad, ​Juridische contextHet decreet over het lokaal bestuur, meer bepaald Titel 2, hoofdstuk 5, afdeling 1 (organisatiebeheersing)De beslissing van de gemeenteraad van 1 juli 2019 houdende de goedkeuring algemeen kader organisatiebeheersing​Feitelijke context en argumentatie​De gemeenten en OCMW’s dienen in te staan voor de organisatiebeheersing van hun activiteiten·Volgens de startnota dient de algemeen directeur jaarlijks een stand van zaken te rapporteren aan de gemeenteraad·Het voorliggend jaarrapport waarin een overzicht van het afgelopen werkjaar (vanaf 30 juni 2021 tot en met 15 mei 2022) en de acties die nog op de planning staan worden toegelichtBeslissingArtikel 1Neemt kennis van het jaarrapport 2022 dat werd opgesteld in samenwerking met het aangesteld bureau betreffende het organisatiebeheersingssysteem van de gemeente en het OCMW van Linkebeek.Artikel 2 Deze beslissing wordt gecommuniceerd aan:​Wie?Hoe?Dienst secretariaatUittreksel OCMWUittreksel                                                  Openbare behandeling van agendapunt                                Aanstelling van een vertegenwoordiger van de gemeente op de algemene vergadering van de gemeentelijke holding nv – in vereffening op 29 juni 2022              (gepland)                      Aanwezigen bij agendapunt                                                     