<http://shaclshapes.org/description70ae4d36-de0c-425d-9dbe-3b6deef8343cShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
  <http://example.org/example> """ 
                                                    De aanpassing van het meerjarenplan nr. 3 - 2020-2025 van het OCMW Zandhoven, dat heden werd vastgesteld door de OCMW-raad, wordt goedgekeurd.De goedkeuring vermeld in artikel 1, impliceert dat de gemeenteraad de aanpassing van het meerjarenplan nr. 3 - 2020-2025 voor beide entiteiten vaststelt. 
                                                """ ;
  <http://example.org/example> """ 
                                                    De raad voor maatschappelijk welzijn neemt kennis van aanpassing 5 van het meerjarenplan 2020-2025 van welzijnsvereniging Zorgbedrijf Meetjesland. 
                                                """ ;
  <http://shaclshapes.org/confidence> 1E0 ;
