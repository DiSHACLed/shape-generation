<http://shaclshapes.org/description40831a2c-771d-4b41-9720-0399998f1873ShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
  <http://example.org/example> """ 
                                                                    Aan de gemeenteraad wordt goedkeuring gevraagd voor de lastvoorwaarden en gunningswijze voor het wegbermbeheer 2022. 
                                                                """ ;
  <http://example.org/example> """ 
                                                                    De gemeenteraad keurt de voorgelegde begroting van de politiezone voor het dienstjaar 2026 goed. 
                                                                """ ;
  <http://example.org/example> """ 
                                                                    De gemeenteraad keurt het ontwerp van de budgetwijziging 2022 van het EVA Cultuurcentrum Strombeek / Grimbergen goed. 
                                                                """ ;
  <http://example.org/example> """ 
                                                                    De gemeenteraad keurt het ontwerp van de budgetwijziging 2023 van het EVA Heemschut goed. 
                                                                """ ;
  <http://example.org/example> """ 
                                                            De Raad voor Maatschappelijk Welzijn wordt gevraagd om de lastvoorwaarden en gunningswijze opdracht Gevelrenovatie met spuitkurk Sociale Residentie 't Vezerhuis goed te keuren. 
                                                        """ ;
  <http://example.org/example> """ 
                                                            De gemeenteraad beslist de verkavelingsakte en de individuele verkoopakten van de loten van het lokaal bedrijventerrein goed te keuren. 
                                                        """ ;
  <http://example.org/example> """ 
                                                            De gemeenteraad keurt de begroting voor 2024 van EVA vzw CC De Steiger Boom goed. 
                                                        """ ;
  <http://example.org/example> """ 
                                                            De gemeenteraad keurt de jaarrekening 2024 goed. 
                                                        """ ;
  <http://example.org/example> """ 
                                                            De gemeenteraad keurt de werkingstoelage van 4.034.896,00 euro en de investeringstoelage van 87.449,00 euro voor Politiezone Voorkempen voor het dienstjaar 2023 goed.  
                                                        """ ;
  <http://example.org/example> """ 
                                                            De gemeenteraad neemt akte van de financiële verdeelsleutel die de jaarlijkse bijdrage van elke gemeente aan de Zone Midwest vastlegt en die door de zoneraad in zitting van 25 oktober 2022 voor de begroting 2023 werd herbevestigd. 
                                                            De gemeenteraad gaat akkoord met de exploitatietoelage van €252.286 aan de Zone Midwest voor 2023. 
                                                            De gemeenteraad gaat akkoord met de investeringstoelage van €52.965 aan de Zone Midwest voor 2023. 
                                                        """ ;
  <http://example.org/example> """ 
                                                            Voor het dienstjaar 2023 zal een gemeentelijke investeringstoelage van 322.174 euro en een werkingstoelage van 1.086.012 euro overgemaakt worden aan de brandweerzone Rand. 
                                                        """ ;
  <http://example.org/example> """ 
                                                    Het vast bureau stelt de overdracht van investerings- en financieringskredieten van 2023 naar 2024 vast. 
                                                """ ;
  <http://example.org/example> "FINANCIEN. Dotaties 2022. Brandweerzone Rand 2022."@nl ;
  <http://example.org/example> "FINANCIEN. Dotaties 2022. IGEAN." ;
