<http://shaclshapes.org/citesLegalExpressionShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
  <http://example.org/example> "Bestuursdecreet" ;
  <http://example.org/example> "De omzendbrief KBBJ/ABB 2024/2 over de start van de lokale en provinciale bestuursperiode" ;
  <http://example.org/example> "Omzendbrief KBBJ/ABB 2024/2 over de start van de lokale en provinciale bestuursperiode" ;
  <http://example.org/example> "art. 71, vijfde lid LPKD" ;
  <http://example.org/example> "artikel 90, §4 van het decreet over het lokaal bestuur" ;
  <http://example.org/example> "besluit van 21 juni 2024" ;
  <http://example.org/example> "betreffende de aanvullende reglementen op het wegverkeer en de plaatsing en bekostiging van de verkeerstekens " ;
  <http://example.org/example> "betreffende de gemeentelijke administratieve sancties" ;
  <http://example.org/example> "betreffende de omgevingsvergunning " ;
  <http://example.org/example> "betreffende de programmatie, de erkenningsvoorwaarden en de subsidieregeling voor woonzorgvoorzieningen en verenigingen van gebruikers en mantelzorgers " ;
  <http://example.org/example> "houdende maatregelen ter bestrijding en voorkoming van leegstand en verwaarlozing van bedrijfsruimten" ;
  <http://example.org/example> "over het lokaal bestuur, Artikel 106." ;
  <http://example.org/example> "over het lokaal bestuur, Artikel 87." ;
  <http://example.org/example> "tot vastlegging van de nadere regels voor de inhoudelijke invulling van de begeleiding zoals vermeld in artikel 7.9.2/1, eerste lid, 5° en 9°, van het Energiebesluit van 19 november 2010" ;
