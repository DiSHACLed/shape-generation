                                                     257.485 \\n                                                                        258.385 \\n                                                                        259.285 \\n                                                                        260.185 \\n                                                                        261.085 \\n                                                                        261.985 \\n                                                                     \\n                                                                     \\n                                                                        IV. Financieringssaldo \\n                                                                        -249.198 \\n                                                                        -249.198 \\n                                                                        -249.198 \\n                                                                        -249.198 \\n                                                                        -249.198 \\n                                                                        -249.198 \\n                                                                     \\n                                                                     \\n                                                                            a. Ontvangsten \\n                                                                        0 \\n                                                                        0 \\n                                                                        0 \\n                                                                        0 \\n                                                                        0 \\n                                                                        0 \\n                                                                     \\n   