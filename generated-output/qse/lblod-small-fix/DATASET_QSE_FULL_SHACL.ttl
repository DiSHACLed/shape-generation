                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             goedgekeurd, met eenparigheid van stemmen                                                    Openbare titel besluit:B.6C Verkeersveiligheid en mobiliteit. Uitbreiding woonerven Korte openbare beschrijving:Uitbreiding woonervenDe gemeenteraad,     Gelet op het Decreet Lokaal Bestuur van 22 december 2017;Gelet op de wet van 29 juli 1991 betreffende de uitdrukkelijke motiveringsplicht van bestuurshandelingen, en latere wijzigingen;Gelet op het Bestuursdecreet van 7 december 2018;Gelet op de wet betreffende de politie over het wegverkeer, gecoördineerd bij koninklijk besluit van 16 maart 1968;Gelet op het decreet van 16 mei 2008 betreffende de aanvullende reglementen op het wegverkeer en de plaatsing en bekostiging van de verkeerstekens;Gelet op het koninklijk besluit van 1 december 1975 houdende algemeen reglement op de politie van het wegverkeer en van het gebruik van de openbare weg;Gelet op het ministerieel besluit van 11 oktober 1976 waarbij de minimumafmetingen en de bijzondere plaatsingsvoorwaarden van de verkeerstekens worden bepaald;Gelet op het besluit van de Vlaamse Regering van 23 januari 2009 betreffende de aanvullende reglementen op het wegverkeer en de plaatsing en bekostiging van de verkeerstekens;Gelet op de omzendbrief MOB/2009/01 van 3 april 2009;Overwegende dat onderstaand besluit alle voorgaande besluiten betreffende woonerven opheft en vervangt;Overwegende dat de gemeente Essen in haar meerjarenplan 2020-2025 de strategische doelstelling GERUST heeft vastgelegd, met als beleidsdoelstelling BD1_Veiligheidsgevoel en verkeersleefbaarheid verhogen-goed en comfortabel leven in Essen en een prioritair actieplan AP41.1 Verkeersleefbaarheid verhogen;Gelet op het advies van de Verkeerspolitie van de PZ Grens;Gelet op de beslissing van het college van 3 juli 2024 om het woonerf Heuvelplein te laten beginnen vanaf de Watermolenstraat en dat er aan de noordzijde nog 2 à 3 parkeerplaatsen worden ingericht waar geparkeerd kan worden;Overwegende dat de te reglementeren wegen behoren tot de gemeentewegen;Overwegende dat de te nemen maatregelen dienen om de verkeersveiligheid van de weggebruikers te verhogen;Overwegende dat het advies vanuit de verkeerscel is om het woonerf uit te breiden tot aan de Watermolenstraat, rekening houdend met het feit dat er dan enkel nog op de aangeduide parkeervakken geparkeerd mag worden;Gehoord de toelichting door schepen Brigitte Quick;Beslist,Artikel 1.Besloten wordt akkoord te gaan het instellen van een woonerf op volgende locaties:- Frans Noldusplein- HeuvelpleinArt. 2.De woonerven worden afgebakend aan alle toegangen met borden F12a en aan alle uitgangen door bord F12b. De borden worden geplaatst op volgende locaties :Frans Noldusplein: thv kruispunt met StationsstraatFrans Noldusplein: thv kruispunt met St AntoniuspleinVerbinding Spoorwegstraat-Frans Noldusplein: thv kruispunt met Frans NolduspleinHeuvelplein: tegenover pand 24 (doorrijgedeelte)Heuvelplein: tegenover pand 29 (doorrij o.a. naar garageboxen)Heuvelplein: thv pand 18Melkerijstraat thv kruispunt Heuvelplein/WatermolenstraatArt. 3.Dit reglement heft alle voorgaande snelheidsreglementeringen op in de zone bepaald in artikel 1.Art. 4.Deze beslissing wordt bekendgemaakt conform het Decreet Lokaal Bestuur.Art. 5.Dit aanvullend reglement wordt ter goedkeuring overgemaakt aan de afdeling Beleid Mobiliteit en Verkeersveiligheid.            
            
