<http://shaclshapes.org/descriptiond85218e2-a75f-4a30-9182-512b5c9dd1b2ShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
  <http://example.org/example> """ 
                                                            De gemeenteraad gaat akkoord met de voorgestelde wijziging van de verdeelsleutel op basis van de 3-staps aanpak. 
                                                        """ ;
  <http://example.org/example> """ 
                                                            De gemeenteraad neemt akte van het budget 2026 van de kerkfabrieken Sint-Jan-Baptist, Onze-Lieve-Vrouw, Sint-Bavo en Sint-Eligius. 
                                                        """ ;
  <http://example.org/example> """ 
                                                            De gemeenteraad neemt akte van het budget 2026 van het kerkbestuur St.-Catharina. 
                                                        """ ;
  <http://example.org/example> """ 
                                                            De gemeenteraad neemt akte van het budget 2026 van het kerkbestuur St.-Niklaas. 
                                                        """ ;
  <http://example.org/example> """ 
                                                            De gemeenteraad neemt akte van het budget 2026 van het kerkbestuur St.-Rumoldus. 
                                                        """ ;
  <http://example.org/example> """ 
                                                            De gemeenteraad neemt akte van het budget 2026 van het kerkbestuur St.-Martinus. 
                                                        """ ;
  <http://example.org/example> """ 
                                                    Een gewone dotatie wordt aan de politiezone ‘ZARA’ toegekend ten belope van 2.023.747 euro, uitgetrokken onder ACT-4.2.1/0400-00/649330 van de exploitatie uitgaven van het budget 2026. 
                                                """ ;
  <http://example.org/example> """ 
                                                    Een gewone dotatie wordt aan de politiezone ‘ZARA’ toegekend ten belope van 2.023.747 euro, uitgetrokken onder GBB/0400-00/649330 van de exploitatieuitgaven van het budget 2025. 
                                                """ ;
  <http://shaclshapes.org/confidence> 1E0 ;
