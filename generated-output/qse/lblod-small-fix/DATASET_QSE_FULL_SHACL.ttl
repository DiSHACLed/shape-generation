            Effectieve stemmers                                                                                                                                          Luka                                Augustijns                                                                                                                                                     Manu                                Claes                                                                                                                                                     Gunther                                Coppens                                                                                                                                                     Walter                                De Donder                                                                                                                                                     Ella                                De Neve                                                                                                                                                     Tom                                Dehaene                                                                                                                                                     Bertrand                                Demiddeleer                                                                                                                                                     Françoise                                Devleeschouwer                                                                                                                                                     Lucia                                Dewolfs                                                                                                                                                     Diederik                                Dunon                                                                                                                                                     Tine                                Eerlingen                                                                                                                                                     Steven                                Elpers                                                                                                                                                     Marc                                Florquin                                                                                                                                                     Daniel                                Fonteyne                                                                                                                                                     Lena                                 Ghysels                                                                                                                                                     Finke                                Jacobs                                                                                                                                                     Hilde                                Kaspers                                                                                                                                                     Nicolas                                Kuczynski                                                                                                                                                     Koen                                Moeyersons                                                                                                                                                     Noor                                Mousaid                                                                                                                                                     Bart                                 Nevens                                                                                                                                                     Isabelle                                Pierreux                                                                                                                                                     Eddy                                Poffé                                                                                                                                                     Tie                                Roefs                                                                                                                                                     Ann                                Schevenels                                                                                                                                                     Willy                                Smout                                                                                                                                                     Sarah                                Sneyers                                                                                                                                                     Monique                                Swinnen                                                                                                                                                     Louis                                Tobback                                                                                                                                                     Joris                                Van den Cruijce                                                                                                                                                     Linda                                Van den Eede                                                                                                                                                     Geertrui                                Windels                                                                                                                                                     Marc                                Wynants                                                                                                                                                     Elke                                Zelderloo                                                                                                                                                     Walter                                Zelderloo                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              