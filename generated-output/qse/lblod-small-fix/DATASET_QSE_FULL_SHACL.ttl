<http://shaclshapes.org/descriptionec8652a6-2c49-4955-8d59-fd08c8c0a6e1ShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
  <http://example.org/example> """ 
                                                    De raad keurt het tarievenreglement van de openbare bibliotheek goed. 
                                                """ ;
  <http://example.org/example> """ 
                                                    De raad van bestuur hecht zijn goedkeuring aan de formulering van het voorstel van tariefregeling voor het gebruik van evenementenhal “De Populier”. Deze beslissing zal voor goedkeuring aan de gemeenteraad van Zandhoven worden voorgelegd. 
                                                """ ;
  <http://example.org/example> """ 
                                                    De raad van bestuur hecht zijn goedkeuring aan de formulering van het voorstel van tariefregeling voor het gebruik van sportcomplex “Het Veld”. Deze beslissing zal voor goedkeuring aan de gemeenteraad van Zandhoven worden voorgelegd. 
                                                """ ;
  <http://shaclshapes.org/confidence> 7.5E-1 ;
  <http://shaclshapes.org/support> "3"^^xsd:int ;
  <http://www.w3.org/ns/shacl#NodeKind> <http://www.w3.org/ns/shacl#Literal> ;
