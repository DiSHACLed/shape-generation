<http://shaclshapes.org/value79414af4-4f57-4ca3-aaa4-f8f1e015e71cShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
  <http://example.org/example> """" \\n                                                                         \\n                                                                            BESLUIT: \\n                                                                            Artikel 1. \\n                                                                            Een gunstig advies uit te brengen over de jaarrekening 2023, vastgesteld op 20 februari 2024 door de kerkraad Heilig Hart (Verbrande Brug). \\n                                                                              \\n                                                                            Art. 2. \\n                                                                            De dienst financiën maakt voor goedkeuring een exemplaar van deze beslissing over aan de gouverneur van de provincie Vlaams-Brabant. \\n                                                                         \\n                                                                    "( )""" ;
  <http://example.org/example> """" \\n                                                                 \\n                                                                    Beslissing \\n                                                                    Artikel 1. \\n                                                                    De bovenvermelde rekening voor het dienstjaar 2022 van kerkfabriek Sint-Jan-de-Doper Schulen GUNSTIG te adviseren. \\n                                                                    Artikel 2. \\n                                                                    Deze rekening ter goedkeuring aan de Heer provinciegouverneur voor te leggen. \\n                                                                    Artikel 3. \\n                                                                    Onderhavig raadsbesluit in toepassing van artikel 286 tot en met 288 van het decreet lokaal bestuur van 22 december 2017 mee te delen aan de heer Provinciegouverneur terwijl een afschrift van deze beslissing ter kennisgeving en uitvoering wordt overgemaakt aan: \\n                                                                    -        De Heer Piet Rymen, voorzitter Centraal Kerkbestuur Herk-de-Stad \\n                                                                    -        Dienst Financiën \\n                                                                 \\n                                                            "( )""" ;
  <http://example.org/example> """" \\n                                                                 \\n                                                                    Besluit \\n                                                                    Art. 1 : De raad beslist een gunstig advies te geven bij de jaarrekening 2024 van de kerkfabriek Sint-Marie, deelgemeente Everbeek Beneden. \\n                                                                    Art. 2 : Afschrift van deze beslissing zal toegestuurd worden aan: - de heer Gouverneur van Oost-Vlaanderen; - de voorzitter van het centraal kerkbestuur; \\n                                                                 \\n                                                            "( )""" ;
  <http://example.org/example> """" \\n                                                                 \\n                                                                    Besluit \\n                                                                    Art.1 De gemeenteraad verleent een gunstig advies over de jaarrekening 2023 van de kerkfabriek Sint-Martinus. \\n                                                                      \\n                                                                    Art.2 De beslissing wordt overgemaakt aan de kerkfabriek, het centraal kerkbestuur en de gouverneur. \\n                                                                 \\n                                                            "( )""" ;
  <http://example.org/example> """" \\n                                                         \\n                                                            Besluit \\n                                                            Gunstig advies wordt verstrekt aan de rekening van de kerkfabriek St.-Martinus Koolskamp voor het jaar 2024 zoals voorgelegd in bijlage. \\n                                                         \\n                                                    "( )""" ;
  <http://example.org/example> """" \\n                                 \\n                                    Artikel 1. De raad brengt een positief advies uit over de jaarrekening 2021 van de kerkfabriek Sint-Jan Evangelist Tervuren.Artikel 2. Afschrift van deze beslissing wordt bezorgd aan de gouverneur van de provincie Vlaams-Brabant. \\n                                 \\n                            "( )""" ;
  <http://example.org/example> """" \\n                                 \\n                                    BESLUIT: \\n                                    Artikel 1. \\n                                    Een gunstig advies uit te brengen over de jaarrekening 2023, vastgesteld op 26 februari 2024 door de kerkraad Sint-Amandus (Strombeek). \\n                                      \\n                                    Art. 2. \\n                                    De dienst financiën maakt een exemplaar van deze beslissing over aan de gouverneur van de provincie Vlaams-Brabant. \\n                                 \\n                            "( )""" ;
  <http://example.org/example> """" \\n                                 \\n                                    BESLUIT: \\n                                    Artikel 1. \\n                                    Een gunstig advies uit te brengen over de jaarrekening 2024, vastgesteld op 3 februari 2025 door de kerkraad Sint-Rumoldus (Humbeek). \\n                                      \\n                                    Art. 2. \\n                                    De dienst Financiën maakt voor goedkeuring een exemplaar van deze beslissing over aan de gouverneur van de provincie Vlaams-Brabant. \\n                                 \\n                            "( )""" ;
  <http://example.org/example> """" \\n                                 \\n                                    Besluit \\n                                    Artikel 1. \\n                                    De rekening 2023 van de kerkfabriek Sint-Jan Teralfene wordt gunstig geadviseerd. \\n                                     \\n                                    Artikel 2. \\n                                    Afschrift van deze beslissing zal aan het Agentschap voor Binnenlands Bestuur, Afdeling Vlaams-Brabant p/a VAC – Leuven, 13de en 14de verdieping, Diestsepoort 6 bus 1 te Leuven, worden toegestuurd. \\n                                     \\n                                    Artikel 3. \\n                                    Afschrift van dit besluit zal ter kennisgeving aan de kerkfabriek Sint-Jan – p/a Driesstraat 5 te 1790 Affligem – en aan de financiële dienst worden bezorgd. \\n                                 \\n                            "( )""" ;
  <http://example.org/example> """" \\n                                 \\n                                    Enig artikel- De gemeenteraad verleent gunstig advies aan de voorliggende dienstjaarrekening van de kerkfabriek Onze Lieve Vrouw Hemelvaart van Watervliet voor het jaar 2023 waarbij de rekening een exploitatieoverschot van 70.073,62 euro en een investeringsoverschot van 5.896,32 euro vertoont. \\n                                 \\n                            "( )""" ;
