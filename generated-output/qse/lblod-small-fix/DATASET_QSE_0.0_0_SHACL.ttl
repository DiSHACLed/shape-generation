<http://shaclshapes.org/descriptione8aee49e-8762-4db2-acfe-2d5dd3c37619ShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
  <http://example.org/example> """" \\n                                                                    Dit agendapunt wordt uiteindelijk niet behandeld wegens opmerkingen van de vakbonden op de ABOC die plaatsvond tussen het versturen van de agenda en deze raadszitting. Deze opmerkingen werden verwerkt en vorige vrijdag aan alle raadsleden nog via mail bezorgd. Er werd eerst over dit agendapunt wel gestemd (eenparigheid van stemmen), maar door tussenkomst van schepen Segers, die er op duidde dat het een aangepaste versie is waarover moest gestemd worden, werd besloten om de eerder gehouden stemming te annuleren en het agendapunt terug voor te leggen aan op gemeenteraadszitting van september. \\n                                                                "( )""" ;
  <http://example.org/example> """" \\n                                                            De aanvullende aanwervingsvoorwaarden voor het ambt van directeur voor het gemeentelijke secundair onderwijs worden goedgekeurd. \\n                                                        "( )""" ;
  <http://example.org/example> """" \\n                                                            De gemeenteraad keurt het aangepaste schoolreglement goed. \\n                                                        "( )""" ;
  <http://example.org/example> """" \\n                                                            Goedgekeurd \\n                                                        "( )""" ;
  <http://example.org/example> """" \\n                                                            Het schoolreglement in bijlage voor GTIL schooljaar 2021-2022 wordt goedgekeurd door het college van burgemeester en schepenen en ter bekrachtiging voorgelegd aan de gemeenteraad. \\n                                                        "( )""" ;
  <http://example.org/example> """" \\n                                                            Naar aanleiding van gewijzigde onderwijswetgeving was een update van het arbeidsreglement van de school noodzakelijk. De huidige aanpassingen werden overlegd en onderhandeld op het ABOC van 05/09/2024. \\n                                                        "( )""" ;
  <http://example.org/example> """" \\n                                                    Academie voor Beeld, Muziek & Woord - Stad Menen: aanpassingen academiereglement naar aanleiding van wijzigingen in het organisatiebesluit omtrent bepalingen afwezigheid van een leerling. \\n                                                "( )""" ;
  <http://example.org/example> """" \\n                                                    De gemeenteraad stelt het arbeidsreglement van de gemeenteschool Lievegem vast. \\n                                                "( )""" ;
  <http://example.org/example> """" \\n                                                    Gemeentelijke basisschool de Wonderwijzer (Lauwe): schoolreglement 2021-2022. \\n                                                "( )""" ;
  <http://example.org/example> """" \\n                                                    Goedgekeurd. \\n                                                "( )""" ;
