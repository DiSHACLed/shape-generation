<http://shaclshapes.org/value4efa4632-efc6-40d5-815a-dec785fbceacShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
  <http://example.org/example> """" \\n                                                                         \\n                                                                            BESLUIT: \\n                                                                            Artikel 1. \\n                                                                            Een gunstig advies te verlenen inzake de samenvoeging van de parochies Sint-Cornelius Molenveld, Allerheiligste Verlosser Borcht en Heilig Hart Verbrande Brug bij de parochie Sint-Servaas. \\n                                                                              \\n                                                                            Art. 2. \\n                                                                            De opdracht te geven aan de dienst financiën om een exemplaar van deze beslissing ter kennisgeving over te maken aan de Vlaamse Regering en het Vicariaat Vlaams-Brabant en Mechelen. \\n                                                                         \\n                                                                    "( )""" ;
  <http://example.org/example> """" \\n                                                                         \\n                                                                            Beslissing \\n                                                                            Artikel 1 \\n                                                                            Verleent gunstig advies over \\n                                                                             \\n                                                                                de samenvoeging van de parochie Sint-Theresia van het Kind Jezus met de te behouden parochie Sint-Hilarius en \\n                                                                                de wijziging van gebiedsomschrijving van de parochie Sint-Theresia van het kind Jezus. \\n                                                                             \\n                                                                              \\n                                                                            Artikel 2 \\n                                                                            Dit advies wordt overgemaakt aan het agentschap Binnenlands Bestuur. \\n                                                                         \\n                                                                    "( )""" ;
  <http://example.org/example> """" \\n                                 \\n                                    BESLUIT: \\n                                    Artikel 1. \\n                                    Een gunstig advies te verlenen inzake de samenvoeging van de parochies Sint-Cornelius Molenveld, Allerheiligste Verlosser Borcht en Heilig Hart Verbrande Brug bij de parochie Sint-Servaas. \\n                                      \\n                                    Art. 2. \\n                                    De opdracht te geven aan de dienst financiën om een exemplaar van deze beslissing ter kennisgeving over te maken aan de Vlaamse Regering en het Vicariaat Vlaams-Brabant en Mechelen. \\n                                 \\n                            "( )""" ;
  <http://example.org/example> """" \\n                                 \\n                                    Beslissing \\n                                    Artikel 1 \\n                                    Verleent gunstig advies over \\n                                     \\n                                        de samenvoeging van de parochie Sint-Theresia van het Kind Jezus met de te behouden parochie Sint-Hilarius en \\n                                        de wijziging van gebiedsomschrijving van de parochie Sint-Theresia van het kind Jezus. \\n                                     \\n                                      \\n                                    Artikel 2 \\n                                    Dit advies wordt overgemaakt aan het agentschap Binnenlands Bestuur. \\n                                 \\n                            "( )""" ;
  <http://example.org/example> """" \\n                                 \\n                                    Besluit \\n                                    Artikel 1: Gunstig advies voor afschaffing van parochie Sint-Theresia van het kind Jezus Wevelgem en samenvoeging met parochie Sint-Hilarius Wevelgem \\n                                    Artikel 2: Gunstig advies over de wijziging van de parochiegrenzen met name het toevoegen van het territorium van de parochie Sint-Theresia van het kind Jezus dat gelegen is op het grondgebied van de stad Menen bij het territorium van de parochie Sint-Vedastus Menen.   \\n                                 \\n                            "( )""" ;
