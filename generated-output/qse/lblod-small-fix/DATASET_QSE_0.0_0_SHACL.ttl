<http://shaclshapes.org/description2c2f5e3c-827f-4ad7-906a-176f3bda08ceShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
  <http://example.org/example> """ 
                                                            De gemeenteraad heeft met eenparigheid van stemmen de overeenkomst met statutaire draagkracht voor de oprichting van ILV ZO-Hageland 2021-2025 goedgekeurd. 
                                                        """ ;
  <http://shaclshapes.org/confidence> 1E0 ;
