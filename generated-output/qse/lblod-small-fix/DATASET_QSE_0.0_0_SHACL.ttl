  <http://www.w3.org/ns/shacl#datatype> rdf:langString ;
  <http://www.w3.org/ns/shacl#minCount> 1 ;
  <http://www.w3.org/ns/shacl#path> <http://data.vlaanderen.be/ns/besluit#motivering> .

<http://shaclshapes.org/motiveringBesluitVerkiezingVoorzitterShapeProperty> rdf:type <http://www.w3.org/ns/shacl#PropertyShape> ;
