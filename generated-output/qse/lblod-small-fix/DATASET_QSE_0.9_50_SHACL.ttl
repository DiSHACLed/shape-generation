                                                                                         D10 - verstrekken toelagen  
                                                                                     
                                                                                     
                                                                                         actieplan  
                                                                                         AP026 - buitengewone toelagen  
                                                                                     
                                                                                     
                                                                                         actie  
                                                                                         20431 - buitengewone toelage kerkfabriek Sint-Agnes Wontergem  
                                                                                     
                                                                                     
                                                                                         subproject  
                                                                                         20431/01 - buitengewone toelage kerkfabriek Sint-Agnes Wontergem  
                                                                                     
                                                                                     
