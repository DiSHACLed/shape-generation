anderen.be/id/concept/Verkeersbordconcept/84567323c818fdb559cc3df4dbc141d3e24efcf6f528473c5c0ec20e180e56e2\"></span><span rev=\"https://data.vlaanderen.be/ns/mobiliteit#wordtAangeduidDoor\" resource=\"http://data.lblod.info/mobiliteitsmaatregels/8c9e7a40-2ffa-4332-975b-7aab058fd2ef\"></span></span><span data-content-container=\"true\">Onderbord GVIId</span></span></p></li><li class=\"say-list-item\" data-list-marker=\"3. \"><p class=\"say-paragraph\"><span class=\"say-inline-rdfa\" about=\"http://data.lblod.info/verkeerstekens/d3c41683-fd86-45e0-b91f-8bb97da01ca1\" data-say-id=\"b56b8f1a-987a-4e7f-8960-e31be786bf99\"><span class=\"say-hidden\" data-rdfa-container=\"true\" style=\"display: none;\"><span about=\"http://data.lblod.info/verkeerstekens/d3c41683-fd86-45e0-b91f-8bb97da01ca1\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"https://data.vlaanderen.be/ns/mobiliteit#Verkeersteken\"></span><span about=\"http://data.lblod.info/verkeerstekens/d3c41683-fd86-45e0-b91f-8bb97da01ca1\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"https://data.vlaanderen.be/ns/mobiliteit#Verkeersbord\"></span><span about=\"http://data.lblod.info/verkeerstekens/d3c41683-fd86-45e0-b91f-8bb97da01ca1\" property=\"https://data.vlaanderen.be/ns/mobiliteit#heeftVerkeersbordconcept\" resource=\"http://data.vlaanderen.be/id/concept/Verkeersbordconcept/735cd32e48f1535d2c9a1dc572e8e03a3d5907b7402675f901672d6c28d1a341\"></span><span rev=\"https://data.vlaanderen.be/ns/mobiliteit#wordtAangeduidDoor\" resource=\"http://data.lblod.info/mobiliteitsmaatregels/8c9e7a40-2ffa-4332-975b-7aab058fd2ef\"></span></span><span data-content-container=\"true\">Onderbord GXc</span></span></p></li></ul></div></div>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML>>  ?;
            # 0.011622501162250116 % (1 instance). obj: <http://dbpedia.org/datatype/</span></span>  het parkeren is toegelaten;  het parkeren is voorbehouden voor <span class=\"say-codelist-variable\" data-say-variable=\"true\" data-say-variable-type=\"codelist\" data-label=\"categorie_voertuig\" data-codelist=\"http://lblod.data.gift/concept-schemes/61AE3534BF5C750009000050\" data-source=\"https://register.mobiliteit.vlaanderen.be/sparql\" about=\"http://data.lblod.info/variable-instances/3e4f4828-44c7-48d1-8ce6-88cbb3f07fea\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#value\" data-literal-node=\"true\" data-say-id=\"4bd242f7-99fb-4c33-a1de-bc079c57f12a\" datatype=\"http://www.w3.org/2001/XMLSchema#string\"><span class=\"say-hidden\" data-rdfa-container=\"true\" style=\"display: none;\"><span data-external-triple-container=\"true\"><span about=\"http://data.lblod.info/variable-instances/3e4f4828-44c7-48d1-8ce6-88cbb3f07fea\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"http://lblod.data.gift/vocabularies/variables/VariableInstance\"></span><span about=\"http://data.lblod.info/variable-instances/3e4f4828-44c7-48d1-8ce6-88cbb3f07fea\" property=\"http://lblod.data.gift/vocabularies/variables/instanceOf\" resource=\"http://data.lblod.info/mappings/61AE3580BF5C750009000054\"></span><span property=\"http://purl.org/dc/terms/type\" content=\"codelist\" datatype=\"http://www.w3.org/2001/XMLSchema#string\" about=\"http://data.lblod.info/variable-instances/3e4f4828-44c7-48d1-8ce6-88cbb3f07fea\"></span><span about=\"http://data.lblod.info/variable-instances/3e4f4828-44c7-48d1-8ce6-88cbb3f07fea\" property=\"https://data.vlaanderen.be/ns/mobiliteit#codelijst\" resource=\"http://lblod.data.gift/concept-schemes/61AE3534BF5C750009000050\"></span><span about=\"http://data.lblod.info/variable-instances/3e4f4828-44c7-48d1-8ce6-88cbb3f07fea\" property=\"http://purl.org/dc/terms/source\" resource=\"https://register.mobiliteit.vlaanderen.be/sparql\"></span></span></span><span data-content-container=\"true\">voertuigen die gebruikt worden door personen met een handicap</span></span>;  de parkeerreglementering geldt over een afstand van <span class=\"say-number-variable\" data-say-variable=\"true\" data-say-variable-type=\"number\" data-written-number=\"false\" data-label=\"aanduiding_afstand\" about=\"http://data.lblod.info/variable-instances/c4a049d5-8237-452c-84e6-3369bb39b8d9\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#value\" content=\"6\" data-literal-node=\"true\" data-say-id=\"d6b007ce-91f4-4c70-a755-34f3e31854cb\" datatype=\"http://www.w3.org/2001/XMLSchema#number\"><span class=\"say-hidden\" data-rdfa-container=\"true\" style=\"display: none;\"><span data-external-triple-container=\"true\"><span about=\"http://data.lblod.info/variable-instances/c4a049d5-8237-452c-84e6-3369bb39b8d9\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"http://lblod.data.gift/vocabularies/variables/VariableInstance\"></span><span about=\"http://data.lblod.info/variable-instances/c4a049d5-8237-452c-84e6-3369bb39b8d9\" property=\"http://lblod.data.gift/vocabularies/variables/instanceOf\" resource=\"http://data.lblod.info/mappings/61ADE90ABF5C750009000024\"></span><span property=\"http://purl.org/dc/terms/type\" content=\"number\" datatype=\"http://www.w3.org/2001/XMLSchema#string\" about=\"http://data.lblod.info/variable-instances/c4a049d5-8237-452c-84e6-3369bb39b8d9\"></span></span></span><span data-content-container=\"true\">6</span></span> m.</p><p class=\"say-paragraph\">Dit wordt aangeduid door verkeerstekens:</p><ul hierarchical=\"false\" class=\"say-bullet-list\" style=\"\"><li class=\"say-list-item\" data-list-marker=\"1. \"><p class=\"say-paragraph\"><span class=\"say-inline-rdfa\" about=\"http://data.lblod.info/verkeerstekens/a0b0257c-3c0d-46a3-89e6-fc9c70e08810\" data-say-id=\"30f5952c-0a39-4c4f-bb94-e2d64caddd8c\"><span class=\"say-hidden\" data-rdfa-container=\"true\" style=\"display: none;\"><span about=\"http://data.lblod.info/verkeerstekens/a0b0257c-3c0d-46a3-89e6-fc9c70e08810\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"https://data.vlaanderen.be/ns/mobiliteit#Verkeersteken\"></span><span about=\"http://data.lblod.info/verkeerstekens/a0b0257c-3c0d-46a3-89e6-fc9c70e08810\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"https://data.vlaanderen.be/ns/mobiliteit#Verkeersbord\"></span><span about=\"http://data.lblod.info/verkeerstekens/a0b0257c-3c0d-46a3-89e6-fc9c70e08810\" property=\"https://data.vlaanderen.be/ns/mobiliteit#heeftVerkeersbordconcept\" resource=\"http://data.vlaanderen.be/id/concept/Verkeersbordconcept/0b8edba107bc181f01ea9fcf241c76f6befff04e15a697acf1c6cdeb49e71868\"></span><span rev=\"https://data.vlaanderen.be/ns/mobiliteit#wordtAangeduidDoor\" resource=\"http://data.lblod.info/mobiliteitsmaatregels/8c9e7a40-2ffa-4332-975b-7aab058fd2ef\"></span></span><span data-content-container=\"true\">Verkeersbord E9a</span></span></p></li><li class=\"say-list-item\" data-list-marker=\"2. \"><p class=\"say-paragraph\"><span class=\"say-inline-rdfa\" about=\"http://data.lblod.info/verkeerstekens/672f0e50-f3b2-4d0b-8a15-5f54da1b50ab\" data-say-id=\"2842af6c-81ae-490a-a6be-6c8963804709\"><span class=\"say-hidden\" data-rdfa-container=\"true\" style=\"display: none;\"><span about=\"http://data.lblod.info/verkeerstekens/672f0e50-f3b2-4d0b-8a15-5f54da1b50ab\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"https://data.vlaanderen.be/ns/mobiliteit#Verkeersteken\"></span><span about=\"http://data.lblod.info/verkeerstekens/672f0e50-f3b2-4d0b-8a15-5f54da1b50ab\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"https://data.vlaanderen.be/ns/mobiliteit#Verkeersbord\"></span><span about=\"http://data.lblod.info/verkeerstekens/672f0e50-f3b2-4d0b-8a15-5f54da1b50ab\" property=\"https://data.vlaanderen.be/ns/mobiliteit#heeftVerkeersbordconcept\" resource=\"http://data.vlaanderen.be/id/concept/Verkeersbordconcept/84567323c818fdb559cc3df4dbc141d3e24efcf6f528473c5c0ec20e180e56e2\"></span><span rev=\"https://data.vlaanderen.be/ns/mobiliteit#wordtAangeduidDoor\" resource=\"http://data.lblod.info/mobiliteitsmaatregels/8c9e7a40-2ffa-4332-975b-7aab058fd2ef\"></span></span><span data-content-container=\"true\">Onderbord GVIId</span></span></p></li><li class=\"say-list-item\" data-list-marker=\"3. \"><p class=\"say-paragraph\"><span class=\"say-inline-rdfa\" about=\"http://data.lblod.info/verkeerstekens/d3c41683-fd86-45e0-b91f-8bb97da01ca1\" data-say-id=\"b56b8f1a-987a-4e7f-8960-e31be786bf99\"><span class=\"say-hidden\" data-rdfa-container=\"true\" style=\"display: none;\"><span about=\"http://data.lblod.info/verkeerstekens/d3c41683-fd86-45e0-b91f-8bb97da01ca1\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"https://data.vlaanderen.be/ns/mobiliteit#Verkeersteken\"></span><span about=\"http://data.lblod.info/verkeerstekens/d3c41683-fd86-45e0-b91f-8bb97da01ca1\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"https://data.vlaanderen.be/ns/mobiliteit#Verkeersbord\"></span><span about=\"http://data.lblod.info/verkeerstekens/d3c41683-fd86-45e0-b91f-8bb97da01ca1\" property=\"https://data.vlaanderen.be/ns/mobiliteit#heeftVerkeersbordconcept\" resource=\"http://data.vlaanderen.be/id/concept/Verkeersbordconcept/735cd32e48f1535d2c9a1dc572e8e03a3d5907b7402675f901672d6c28d1a341\"></span><span rev=\"https://data.vlaanderen.be/ns/mobiliteit#wordtAangeduidDoor\" resource=\"http://data.lblod.info/mobiliteitsmaatregels/8c9e7a40-2ffa-4332-975b-7aab058fd2ef\"></span></span><span data-content-container=\"true\">Onderbord GXc</span></span></p></li></ul></div></div>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML>>. Cardinality: {1}
   <https://say.data.gift/ns/body>  <http://dbpedia.org/datatype/ </p><ol class=\"say-ordered-list\" style=\"list-style-type: decimal;\"><li class=\"say-list-item\" data-list-marker=\"1. \"><p class=\"say-paragraph\">de naam, de hoedanigheid, het adres of de zetel van de belastingschuldige ten laste van wie de belasting gevestigd wordt;</p></li><li class=\"say-list-item\" data-list-marker=\"2. \"><p class=\"say-paragraph\">het voorwerp van het bezwaarschrift en een opgave van de feiten en van de middelen;</p></li><li class=\"say-list-item\" data-list-marker=\"3. \"><p class=\"say-paragraph\">de vraag om al dan niet gehoord te worden op een hoorzitting.</p></li></ol><p class=\"say-paragraph\">§3. Het bezwaarschrift moet op straffe van verval worden ingediend binnen termijn van drie maanden te rekenen vanaf de derde werkdag volgend op de verzending van het aanslagbiljet waarop de bezwaartermijn vermeld staat.<br class=\"say-hard-break\">Het indienen van een bezwaar heft evenwel de eisbaarheid van de belasting niet op en ontslaat de belastingschuldige niet van de verplichting deze binnen de opgelegde termijn te betalen. </p>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML>>  ?;
            # 0.011622501162250116 % (1 instance). obj: <http://dbpedia.org/datatype/ </p><ol class=\"say-ordered-list\" style=\"list-style-type: decimal;\"><li class=\"say-list-item\" data-list-marker=\"1. \"><p class=\"say-paragraph\">de naam, de hoedanigheid, het adres of de zetel van de belastingschuldige ten laste van wie de belasting gevestigd wordt;</p></li><li class=\"say-list-item\" data-list-marker=\"2. \"><p class=\"say-paragraph\">het voorwerp van het bezwaarschrift en een opgave van de feiten en van de middelen;</p></li><li class=\"say-list-item\" data-list-marker=\"3. \"><p class=\"say-paragraph\">de vraag om al dan niet gehoord te worden op een hoorzitting.</p></li></ol><p class=\"say-paragraph\">§3. Het bezwaarschrift moet op straffe van verval worden ingediend binnen termijn van drie maanden te rekenen vanaf de derde werkdag volgend op de verzending van het aanslagbiljet waarop de bezwaartermijn vermeld staat.<br class=\"say-hard-break\">Het indienen van een bezwaar heft evenwel de eisbaarheid van de belasting niet op en ontslaat de belastingschuldige niet van de verplichting deze binnen de opgelegde termijn te betalen. </p>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML>>. Cardinality: {1}
   <https://say.data.gift/ns/body>  <http://dbpedia.org/datatype/</p><ol class=\"say-ordered-list\" style=\"list-style-type: decimal;\"><li class=\"say-list-item\" data-list-marker=\"1. \"><p class=\"say-paragraph\">de naam, de hoedanigheid, het adres of de zetel van de belastingschuldige ten laste van wie de belasting gevestigd wordt;</p></li><li class=\"say-list-item\" data-list-marker=\"2. \"><p class=\"say-paragraph\">het voorwerp van het bezwaarschrift en een opgave van de feiten en de middelen.</p></li></ol><p class=\"say-paragraph\">§3. Het bezwaarschrift moet op straffe van verval worden ingediend binnen een termijn van drie maanden vanaf de derde werkdag volgend op de datum van verzending van het aanslagbiljet of vanaf de kennisgeving van de aanslag of vanaf de datum van de contante inning.</p><p class=\"say-paragraph\">§4. De bevoegde overheid stuurt binnen vijftien kalenderdagen na het indienen van een bezwaarschrift een ontvangstmelding naar de belastingplichtige of zijn vertegenwoordiger.</p><p class=\"say-paragraph\">§5. Als de belastingschuldige of zijn vertegenwoordiger dat in het bezwaarschrift heeft gevraagd, zal de belastingschuldige of zijn vertegenwoordiger overeenkomstig artikel 9 van het decreet van 30 mei 2008 betreffende de vestiging, de invordering en de geschillenprocedure van provincie- en gemeentebelastingen uitgenodigd worden op een hoorzitting. De belastingschuldige of zijn vertegenwoordiger wordt gehoord door een personeelslid van niveau A van de gemeente. Beide personen ondertekenen het proces-verbaal van verhoor.</p><p class=\"say-paragraph\">§6. Het college van burgemeester en schepenen doet binnen een termijn van 6 maanden te rekenen vanaf de datum van ontvangst van het bezwaarschrift, uitspraak op basis van een met redenen omklede beslissing.</p>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML>>  ?;
            # 0.011622501162250116 % (1 instance). obj: <http://dbpedia.org/datatype/</p><ol class=\"say-ordered-list\" style=\"list-style-type: decimal;\"><li class=\"say-list-item\" data-list-marker=\"1. \"><p class=\"say-paragraph\">de naam, de hoedanigheid, het adres of de zetel van de belastingschuldige ten laste van wie de belasting gevestigd wordt;</p></li><li class=\"say-list-item\" data-list-marker=\"2. \"><p class=\"say-paragraph\">het voorwerp van het bezwaarschrift en een opgave van de feiten en de middelen.</p></li></ol><p class=\"say-paragraph\">§3. Het bezwaarschrift moet op straffe van verval worden ingediend binnen een termijn van drie maanden vanaf de derde werkdag volgend op de datum van verzending van het aanslagbiljet of vanaf de kennisgeving van de aanslag of vanaf de datum van de contante inning.</p><p class=\"say-paragraph\">§4. De bevoegde overheid stuurt binnen vijftien kalenderdagen na het indienen van een bezwaarschrift een ontvangstmelding naar de belastingplichtige of zijn vertegenwoordiger.</p><p class=\"say-paragraph\">§5. Als de belastingschuldige of zijn vertegenwoordiger dat in het bezwaarschrift heeft gevraagd, zal de belastingschuldige of zijn vertegenwoordiger overeenkomstig artikel 9 van het decreet van 30 mei 2008 betreffende de vestiging, de invordering en de geschillenprocedure van provincie- en gemeentebelastingen uitgenodigd worden op een hoorzitting. De belastingschuldige of zijn vertegenwoordiger wordt gehoord door een personeelslid van niveau A van de gemeente. Beide personen ondertekenen het proces-verbaal van verhoor.</p><p class=\"say-paragraph\">§6. Het college van burgemeester en schepenen doet binnen een termijn van 6 maanden te rekenen vanaf de datum van ontvangst van het bezwaarschrift, uitspraak op basis van een met redenen omklede beslissing.</p>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML>>. Cardinality: {1}
   <https://say.data.gift/ns/body>  <http://dbpedia.org/datatype/</p><ol class=\"say-ordered-list\" style=\"list-style-type: decimal;\"><li class=\"say-list-item\" data-list-marker=\"1. \"><p class=\"say-paragraph\">De naam, de hoedanigheid, het adres of de zetel van de belastingplichtige ten laste van wie de belasting gevestigd wordt;</p></li><li class=\"say-list-item\" data-list-marker=\"2. \"><p class=\"say-paragraph\">Het voorwerp van het bezwaarschrift en een opgave van de feiten en de middelen.</p></li></ol><p class=\"say-paragraph\">§3 Het bezwaarschrift moet op straffe van verval worden ingediend binnen een termijn van drie maanden vanaf de derde werkdag volgend op de datum van de verzending van het aanslagbiljet waarop de bezwaartermijn vermeld staat, of van de kennisgeving van de aanslag.</p>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML>>  ?;
            # 0.011622501162250116 % (1 instance). obj: <http://dbpedia.org/datatype/</p><ol class=\"say-ordered-list\" style=\"list-style-type: decimal;\"><li class=\"say-list-item\" data-list-marker=\"1. \"><p class=\"say-paragraph\">De naam, de hoedanigheid, het adres of de zetel van de belastingplichtige ten laste van wie de belasting gevestigd wordt;</p></li><li class=\"say-list-item\" data-list-marker=\"2. \"><p class=\"say-paragraph\">Het voorwerp van het bezwaarschrift en een opgave van de feiten en de middelen.</p></li></ol><p class=\"say-paragraph\">§3 Het bezwaarschrift moet op straffe van verval worden ingediend binnen een termijn van drie maanden vanaf de derde werkdag volgend op de datum van de verzending van het aanslagbiljet waarop de bezwaartermijn vermeld staat, of van de kennisgeving van de aanslag.</p>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML>>. Cardinality: {1}
   <https://say.data.gift/ns/body>  <http://dbpedia.org/datatype/</span></span>  voetgangers moeten de oversteekplaats volgen om de rijbaan over te steken.</p><p class=\"say-paragraph\">Dit wordt aangeduid door verkeerstekens:</p><ul hierarchical=\"false\" class=\"say-bullet-list\" style=\"\"><li class=\"say-list-item\" data-list-marker=\"1. \"><p class=\"say-paragraph\"><span class=\"say-inline-rdfa\" about=\"http://data.lblod.info/verkeerstekens/5d7a074c-8ccd-4868-926c-ac756a3e84b9\" data-say-id=\"21669e57-a0d6-4ec0-86a2-fca29f75ba67\"><span class=\"say-hidden\" data-rdfa-container=\"true\" style=\"display: none;\"><span about=\"http://data.lblod.info/verkeerstekens/5d7a074c-8ccd-4868-926c-ac756a3e84b9\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"https://data.vlaanderen.be/ns/mobiliteit#Verkeersteken\"></span><span about=\"http://data.lblod.info/verkeerstekens/5d7a074c-8ccd-4868-926c-ac756a3e84b9\" property=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\" resource=\"https://data.vlaanderen.be/ns/mobiliteit#Wegmarkering\"></span><span about=\"http://data.lblod.info/verkeerstekens/5d7a074c-8ccd-4868-926c-ac756a3e84b9\" property=\"https://data.vlaanderen.be/ns/mobiliteit#heeftVerkeersbordconcept\" resource=\"http://data.vlaanderen.be/id/concept/Wegmarkeringsconcept/34b31ed053d2b54d905867eddeeb7bcf\"></span><span rev=\"https://data.vlaanderen.be/ns/mobiliteit#wordtAangeduidDoor\" resource=\"http://data.lblod.info/mobiliteitsmaatregels/12eb1aa7-edd5-4f75-8381-3e5d8421316f\"></span></span><span data-content-container=\"true\">Wegmarkering WM76.3</span></span></p></li></ul></div></div>"^^<http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML>>  ?;
