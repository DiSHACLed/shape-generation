:ArchiveComponent a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node :CreativeWork ;
            sh:path <http://schema.org/exampleOfWork> ],
        [ a sh:PropertyShape ;
            sh:in ( <http://schema.org/ProductModel> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <http://schema.org/workExample> ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:node :Statement ;
            sh:path <http://schema.org/subjectOf> ],
        [ a sh:PropertyShape ;
            sh:in ( <http://schema.org/ArchiveComponent> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://schema.org/materialExtent> ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <http://schema.org/sameAs> ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://schema.org/name> ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
