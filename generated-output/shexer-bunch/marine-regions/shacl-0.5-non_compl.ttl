:200NMZoneBeyondTheCoastline a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 39 ;
            sh:minCount 39 ;
            sh:node :MRGeoObject ;
            sh:path <http://marineregions.org/ns/ontology#contains> ],
        [ a sh:PropertyShape ;
            sh:in ( <http://marineregions.org/ns/ontology#MRGeoObject> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path rdfs:seeAlso ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path skos:altLabel ],
        [ a sh:PropertyShape ;
            sh:in ( <http://marineregions.org/ns/placetypes#200NMZoneBeyondTheCoastline> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <http://marineregions.org/ns/ontology#hasGeometry> ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dcterms:modified ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <http://marineregions.org/ns/ontology#partlyContains> ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path prov:hadPrimarySource ],
        [ a sh:PropertyShape ;
            sh:dataType <http://www.openlinksw.com/schemas/virtrdf#Geometry> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path dcat:bbox ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:maxCount 2 ;
            sh:minCount 2 ;
            sh:path skos:note ],
        [ a sh:PropertyShape ;
            sh:maxCount 2 ;
            sh:minCount 2 ;
            sh:node :IHOSeaArea ;
