:AgentInPositie a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:dataType xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path vl_mand:einde ],
        [ a sh:PropertyShape ;
            sh:in ( vl_mand:Mandataris ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:maxCount 2 ;
            sh:minCount 2 ;
            sh:node :Person ;
            sh:path vl_mand:isBestuurlijkeAliasVan ],
        [ a sh:PropertyShape ;
            sh:in ( <http://data.lblod.info/vocabularies/contacthub/AgentInPositie> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path rdf:type ],
        [ a sh:PropertyShape ;
            sh:maxCount 2 ;
            sh:minCount 2 ;
            sh:node :Concept ;
            sh:path vl_mand:status ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path vl_mand:start ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node :Mandaat ;
            sh:path org:holds ],
        [ a sh:PropertyShape ;
            sh:dataType xsd:string ;
            sh:maxCount 2 ;
            sh:minCount 2 ;
            sh:path mu_core:uuid ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path org:hasMembership ] ;
    sh:targetClass <http://data.lblod.info/vocabularies/contacthub/AgentInPositie> .

:BeleidsdomeinCode a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
